{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": [
      "node"
    ],
    "paths": {
      "@odft/*": [
        "./packages/*/src/index.ts"
      ],
      "@/*": [
        "./apps/web/src/*.ts"
      ],
      "next/server": [
        "./node_modules/next/server.d.ts"
      ]
    },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
