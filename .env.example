# Local development configuration example.
#
# Preferred: run `npm run setup:env`, which writes a `.env` with a random
# SESSION_HMAC_KEY and never overwrites an existing file. If you copy this file
# manually, you MUST replace SESSION_HMAC_KEY (the placeholder is intentionally
# too short to pass validation) and never commit real secrets.

# Required server secrets -----------------------------------------------------
DATABASE_URL=postgres://odft:odft_local_password@127.0.0.1:5442/odft
TEST_DATABASE_URL=postgres://odft:odft_local_password@127.0.0.1:5442/odft_test
PUBLIC_BASE_URL=http://localhost:3000
SESSION_HMAC_KEY=replace-me

# AI configuration ------------------------------------------------------------
# fixture (default; no credentials needed) | openrouter
# In openrouter mode BOTH the API key and AI_CONFIG_PATH are required, and the
# worker/script fail closed without them.
AI_MODE=fixture
# OPENROUTER_API_KEY=
# Path to the role-profile JSON file (all four roles: intent/recommendation/
# planner/reviewer). Start from the committed template:
#   cp ai-profiles.example.json ai-profiles.json
# Then run `npm run ai:validate-models`; it refreshes the capability/pricing
# cache at "<AI_CONFIG_PATH>.capabilities.json" and stamps the verified
# pricingVersion into the profiles. See README "AI modes and configuration".
# AI_CONFIG_PATH=./ai-profiles.json

# Business limits -------------------------------------------------------------
MAX_PLANNING_ATTEMPTS=10
MAX_PROVIDER_ATTEMPTS=10
MAX_LLM_CALLS_PER_TRIP=40
MAX_LLM_COST_USD_PER_TRIP=5.00

# Voice control (optional; off by default) ------------------------------------
# Fixture mode (AI_MODE=fixture) needs no credentials and no profile file. Live
# mode additionally requires VOICE_CONFIG_PATH and a DEDICATED OpenRouter STT
# key restricted to Groq — never the shared OPENROUTER_API_KEY. Start from the
# committed template and validate:
#   cp voice-profiles.example.json voice-profiles.json
#   npm run voice:validate-models
# Create the key, then create and ASSIGN a guardrail to it (provider allowlist
# exactly "groq", model allowlist exactly "openai/whisper-large-v3-turbo") — a
# guardrail enforces nothing until assigned. See README "Voice control
# (optional)" for the full runbook and failure behavior.
VOICE_ENABLED=false
# OPENROUTER_STT_API_KEY=
# VOICE_CONFIG_PATH=./voice-profiles.json

# Optional / demo controls ----------------------------------------------------
DEMO_CONTROLS_ENABLED=true
# Optional public Leaflet tile URL template ({z}/{x}/{y}) for the itinerary map.
# Unset = the labeled SVG schematic fallback. Must be credential-free (https when
# the app is https). See README "Map tiles".
# MAP_TILE_URL=
WORKER_CONCURRENCY=2
# Trust X-Forwarded-For / X-Real-IP for the client IP used by pre-session rate
# limits. Leave false unless the app runs behind a known reverse proxy; when
# false, forwarded headers are ignored so they cannot spoof new rate buckets.
TRUST_PROXY=false
# On-demand landmark curation (off by default, never in tests): look a
# generic-only city's landmarks up from Wikidata on the first trip and store
# them so later trips reuse the reference rows.
# WIKIDATA_DISCOVERY=true
